{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@types/*": ["packages/types/*"],
      "@shared/*": ["libs/shared/*"]
    },
    "module": "CommonJS",
    "typeRoots": ["./packages/types", "./libs/shared/types"],
    "target": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
