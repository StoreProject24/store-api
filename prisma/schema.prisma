generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id         Int          @id @default(autoincrement())
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  users      Users[]
  products   Products[]
  categories Categories[]
  brands     Brands[]
  Stores     Stores[]
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  urlImage  String
  otpCode   String?
  phone     String
  status    Status   @relation(fields: [statusId], references: [id])
  statusId  Int
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  stores    Stores[]
}

model Stores {
  id        Int        @id @default(autoincrement())
  name      String
  address   String
  logoUrl   String
  bannerUrl String
  domain    String     @unique
  city      String
  zip       String
  phone     String
  email     String     @unique
  User      Users?     @relation(fields: [userId], references: [id])
  userId    Int
  status    Status     @relation(fields: [statusId], references: [id])
  statusId  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  products  Products[]
  Brands    Brands[]
}

model Brands {
  id        Int        @id @default(autoincrement())
  name      String
  urlImage  String
  store     Stores     @relation(fields: [storeId], references: [id])
  storeId   Int
  status    Status     @relation(fields: [statusId], references: [id])
  statusId  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  products  Products[]
}

model Categories {
  id        Int        @id @default(autoincrement())
  name      String
  urlImage  String
  status    Status     @relation(fields: [statusId], references: [id])
  statusId  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  products  Products[]
}

model Products {
  id          Int               @id @default(autoincrement())
  name        String
  price       Float
  sku         String
  quantity    Int
  description String
  pricePublic Float
  store       Stores            @relation(fields: [storeId], references: [id])
  storeId     Int
  brands      Brands?           @relation(fields: [brandId], references: [id])
  brandId     Int?
  status      Status            @relation(fields: [statusId], references: [id])
  statusId    Int               @default(1)
  categories  Categories?       @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now())
  images      ProductImages[]
  variants    ProductVariants[]
}

model ProductImages {
  id        Int      @id @default(autoincrement())
  urlImage  String
  product   Products @relation(fields: [productId], references: [id])
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ProductVariants {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  sku       String
  quantity  Int
  product   Products @relation(fields: [productId], references: [id])
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  ADMINSTORE
}
