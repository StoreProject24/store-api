generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id            Int             @id @default(autoincrement())
  name          String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  users         Users[]
  products      Products[]
  categories    Categories[]
  brands        Brands[]
  Stores        Stores[]
  SubCategories SubCategories[]
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  urlImage  String
  otpCode   String?
  phone     String
  status    Status   @relation(fields: [statusId], references: [id])
  statusId  Int
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  stores    Stores[]
}

model Stores {
  id            Int             @id @default(autoincrement())
  name          String
  address       String
  logoUrl       String
  bannerUrl     String
  domain        String          @unique
  city          String
  department    String
  zip           String
  phone         String
  email         String          @unique
  whatsapp      String          @default("")
  tiktok        String          @default("")
  facebook      String          @default("")
  User          Users?          @relation(fields: [userId], references: [id])
  userId        Int
  status        Status          @relation(fields: [statusId], references: [id])
  statusId      Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  products      Products[]
  Brands        Brands[]
  Categories    Categories[]
  SubCategories SubCategories[]
}

model Brands {
  id        Int        @id @default(autoincrement())
  name      String
  urlImage  String
  store     Stores     @relation(fields: [storeId], references: [id])
  storeId   Int
  status    Status     @relation(fields: [statusId], references: [id])
  statusId  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  products  Products[]
}

model Categories {
  id            Int             @id @default(autoincrement())
  name          String
  urlImage      String
  emoji         String          @default("")
  status        Status          @relation(fields: [statusId], references: [id])
  statusId      Int
  stores        Stores          @relation(fields: [storeId], references: [id])
  storeId       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  products      Products[]
  subCategories SubCategories[]
}

model SubCategories {
  id         Int        @id @default(autoincrement())
  name       String
  status     Status     @relation(fields: [statusId], references: [id])
  statusId   Int
  categories Categories @relation(fields: [categoryId], references: [id])
  categoryId Int
  store      Stores     @relation(fields: [storeId], references: [id])
  storeId    Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
}

model Products {
  id                  Int                  @id @default(autoincrement())
  name                String
  price               Float                @default(0)
  sku                 String
  quantity            Int
  description         String
  pricePublic         Float
  tags                String[]             @default([""])
  store               Stores               @relation(fields: [storeId], references: [id])
  storeId             Int
  brands              Brands?              @relation(fields: [brandId], references: [id])
  brandId             Int?
  status              Status               @relation(fields: [statusId], references: [id])
  statusId            Int                  @default(1)
  categories          Categories?          @relation(fields: [categoryId], references: [id])
  variantTypes        VariantType[]        
  variantCombinations VariantCombination[] 
  categoryId          Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now())
  images              ProductImages[]      
  video               String               @default("")
}

model ProductImages {
  id        Int      @id @default(autoincrement())
  urlImage  String
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model VariantType {
  id        Int             @id @default(autoincrement())
  name      String
  product   Products        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  options   VariantOption[]
}

model VariantOption {
  id     Int         @id @default(autoincrement())
  name   String
  value  String
  status Boolean     @default(true)
  type   VariantType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  typeId Int
  combinationValues VariantCombinationValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([typeId, name])
}

model VariantCombination {
  id          Int                       @id @default(autoincrement())
  product     Products                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int
  price       Float                     @default(0)
  pricePublic Float                     @default(0)
  quantity    Int                       @default(0)
  sku         String
  status      Boolean                   @default(true)
  values      VariantCombinationValue[]
}

model VariantCombinationValue {
  id            Int                @id @default(autoincrement())
  combination   VariantCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  combinationId Int
  option        VariantOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId      Int
}

enum Role {
  USER
  ADMIN
  ADMINSTORE
}
