{
  "exclude": ["**/*.spec.ts"],
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "~config/*": ["./src/config/*"],
      "~middlewares/*": ["./src/middlewares/*"],
      "~modules/*": ["./src/modules/*"],
      "~services/*": ["./src/services/*"],
      "~utils/*": ["./src/utils/*"],
      "~models/*": ["./src/models/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  }
}
