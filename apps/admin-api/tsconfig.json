{
  "exclude": ["**/*.spec.ts"],
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "~config/*": ["./config/*"],
      "~middlewares/*": ["./middlewares/*"],
      "~modules/*": ["./modules/*"],
      "~services/*": ["./services/*"],
      "~utils/*": ["./utils/*"],
      "~models/*": ["./models/*"],
      "@stores-api/db": ["../../libs/db/index.ts"],
      "@shared/*": ["../../libs/shared/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  }
}