{
  "name": "admin-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon",
    "build": "rm -f tsconfig.tsbuildinfo && tsc && tsc-alias -p tsconfig.json && cp -r src/templates dist/apps/admin-api/src/templates",
    "start": "node ./dist/apps/admin-api/src/index.js"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.17.1"
  },
  "dependencies": {
