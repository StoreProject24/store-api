  },
  "_moduleAliases": {
    "@stores-api/db": "../../libs/db/dist"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.8.3"
